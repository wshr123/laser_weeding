<launch>
    <!-- 激光除草节点 -->
    <node pkg="laser_weeding" type="main.py" name="laser_weeding_node" output="screen" required="true">
        <!-- ========== 模型参数 ========== -->
        <!-- 
            模型类型 (model_type):
            - 'yolov8': YOLOv8 检测模型
            - 'yolov11': YOLOv11 检测模型（推荐）
            - 'rtdetr': RT-DETR 检测模型
        -->
        <param name="model_type" value="yolov11" />
        
        <!-- 模型文件路径（支持 .pt 格式） -->
        <param name="model_path" value="/home/zhong/runs/detect/fake_intra/weights/best.pt" />
        
        <!-- 设备选择: '0' 表示第一块GPU, 'cpu' 表示使用CPU -->
        <param name="device" value="0" />
        
        <!-- 
            跟踪器类型 (tracker_type):
            - 'custom': 自定义跟踪器（基于卡尔曼滤波和匈牙利算法）
            - 'bytetrack': ByteTrack 跟踪器（推荐，性能好）
            - 'botsort': BoTSORT 跟踪器（精度高）
        -->
        <param name="tracker_type" value="bytetrack" />
        
        <!-- 
            检测模式 (detection_mode) - 可选参数，默认 'yolo_pose':
            - 'bbox': 传统检测框模式（使用检测框中心作为对靶点）
            - 'yolo_pose': YOLO11-pose 关键点检测（直接识别杂草根部，推荐）
            - 'yolo_seg': YOLO11-seg 分割模式（计算分割掩膜质心作为对靶点）
            - 'yolo_world_exg': YOLO World + ExG超绿分割（结合检测和传统分割方法）
            
            注意：使用 pose/seg 模式时，需要加载对应的模型文件（.pt格式）
            例如：yolo11n-pose.pt, yolo11n-seg.pt 等
        -->
        <param name="detection_mode" value="bbox" />

        <!-- 检测参数 -->
        <param name="weed_class_id" value="0" />
        <param name="confidence_threshold" value="0.3" />

        <!-- 核心预测参数 -->
        <param name="total_delay" value="0.08" />
        <param name="prediction_time" value="0.5" />
        <param name="use_kalman" value="true" />
        <param name="max_prediction_distance" value="200" />

        <!-- 激光控制 -->
        <param name="aiming_time" value="0.15" />
        <param name="laser_time" value="0.5" />

        <!-- 振镜参数 -->
        <param name="serial_port" value="/dev/ttyACM0" />
        <param name="serial_baudrate" value="115200" />
        <param name="min_move_step" value="0" />

        <!-- 图像与深度话题 -->
        <param name="image_width" value="640" />
        <param name="image_height" value="480" />
        <param name="image_topic" value="/camera/image_raw" />
        <param name="camera_info_topic" value="/camera/camera_info"/>
        <param name="depth_topic" value="/camera/aligned_depth_to_color/image_raw" />

        <!-- 目标管理 -->
        <param name="target_timeout" value="0.3" />
        <param name="min_stable_frames" value="1" />

        <!-- ========== 坐标变换模式选择 ========== -->
        <!-- true: 使用3D几何变换, false: 使用简单线性映射（原始方法）-->
        <param name="use_3d_transform" value="false" />
        <param name="use_reverse_projection" value="false" />

        <!-- 3D变换配置文件路径（仅3D模式时需要）-->
        <param name="transform_config_file" value="$(find laser_weeding)/cam_params.yaml" />

        <!-- ========== 双振镜配置 ========== -->
        <!-- 振镜数量（从配置文件自动读取，或手动指定）-->
        <param name="galvo_count" value="2" />
        <!-- 振镜区域分割方式：vertical（垂直分割，左右）或 horizontal（水平分割，上下）-->
        <param name="galvo_split_axis" value="vertical" />
        <!-- 分割比例：0.0-1.0，vertical模式下表示左振镜占图像宽度的比例，horizontal模式下表示上振镜占图像高度的比例-->
        <param name="galvo_split_ratio" value="0.5" />
        <!-- 重叠区域像素数（两个振镜扫描区域的重叠部分，用于平滑过渡）-->
        <param name="galvo_overlap_px" value="20" />
    </node>

    <node pkg="laser_weeding" type="bag_image_publisher.py" name="bag_image_publisher" output="screen">
        <param name="bag_path" value="/home/zhong/my_workspace/laser_weeding_me/miaojian1.bag" />
        <param name="image_topic_in" value="/camera/image_raw" />
        <param name="image_topic_out" value="/camera/image_raw" />
        <param name="camera_info_topic_in" value="/camera/camera_info" />
        <param name="camera_info_topic_out" value="/camera/camera_info" />
        <param name="playback_rate" value="0.8" />
        <param name="loop" value="false" />
        <param name="update_header_stamp" value="true" />
    </node>
</launch>